{
  "type": "excalidraw",
  "version": 2,
  "source": "hermes-agent",
  "elements": [
    {
      "type": "rectangle",
      "id": "main",
      "x": 400,
      "y": 100,
      "width": 240,
      "height": 80,
      "roundness": { "type": 3 },
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "boundElements": [
        { "id": "t_main", "type": "text" },
        { "id": "a_create", "type": "arrow" },
        { "id": "a_merge", "type": "arrow" },
        { "id": "a_rebase", "type": "arrow" }
      ]
    },
    {
      "type": "text",
      "id": "t_main",
      "x": 420,
      "y": 130,
      "width": 200,
      "height": 25,
      "text": "main / trunk",
      "fontSize": 22,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "main",
      "originalText": "main / trunk",
      "autoResize": true
    },
    {
      "type": "diamond",
      "id": "decision",
      "x": 430,
      "y": 260,
      "width": 180,
      "height": 120,
      "backgroundColor": "#fff3bf",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "boundElements": [
        { "id": "t_decision", "type": "text" },
        { "id": "a_create", "type": "arrow" },
        { "id": "a_merge", "type": "arrow" },
        { "id": "a_rebase", "type": "arrow" },
        { "id": "a_confirm", "type": "arrow" }
      ]
    },
    {
      "type": "text",
      "id": "t_decision",
      "x": 440,
      "y": 300,
      "width": 160,
      "height": 45,
      "text": "Feature confirmed?",
      "fontSize": 18,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "decision",
      "originalText": "Feature confirmed?",
      "autoResize": true
    },
    {
      "type": "rectangle",
      "id": "feature",
      "x": 120,
      "y": 280,
      "width": 220,
      "height": 90,
      "roundness": { "type": 3 },
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "boundElements": [
        { "id": "t_feature", "type": "text" },
        { "id": "a_create", "type": "arrow" },
        { "id": "a_confirm", "type": "arrow" }
      ]
    },
    {
      "type": "text",
      "id": "t_feature",
      "x": 135,
      "y": 305,
      "width": 190,
      "height": 45,
      "text": "Feature branch / worktree",
      "fontSize": 18,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "feature",
      "originalText": "Feature branch / worktree",
      "autoResize": true
    },
    {
      "type": "rectangle",
      "id": "stray",
      "x": 120,
      "y": 480,
      "width": 220,
      "height": 90,
      "roundness": { "type": 3 },
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "boundElements": [
        { "id": "t_stray", "type": "text" }
      ]
    },
    {
      "type": "text",
      "id": "t_stray",
      "x": 135,
      "y": 505,
      "width": 190,
      "height": 45,
      "text": "STRAY BRANCH / worktree",
      "fontSize": 18,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "stray",
      "originalText": "STRAY BRANCH / worktree",
      "autoResize": true
    },
    {
      "type": "arrow",
      "id": "a_create",
      "x": 400,
      "y": 180,
      "width": 160,
      "height": 100,
      "points": [[0, 0], [-160, 100]],
      "endArrowhead": "arrow",
      "strokeWidth": 2,
      "boundElements": [{ "id": "t_a_create", "type": "text" }],
      "startBinding": { "elementId": "main", "fixedPoint": [0, 1] },
      "endBinding": { "elementId": "feature", "fixedPoint": [0.5, 0] }
    },
    {
      "type": "text",
      "id": "t_a_create",
      "x": 290,
      "y": 215,
      "width": 120,
      "height": 20,
      "text": "create branch",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "a_create",
      "originalText": "create branch",
      "autoResize": true
    },
    {
      "type": "arrow",
      "id": "a_confirm",
      "x": 340,
      "y": 325,
      "width": 90,
      "height": 0,
      "points": [[0, 0], [90, 0]],
      "endArrowhead": "arrow",
      "strokeWidth": 2,
      "boundElements": [{ "id": "t_a_confirm", "type": "text" }],
      "startBinding": { "elementId": "feature", "fixedPoint": [1, 0.5] },
      "endBinding": { "elementId": "decision", "fixedPoint": [0, 0.5] }
    },
    {
      "type": "text",
      "id": "t_a_confirm",
      "x": 355,
      "y": 305,
      "width": 80,
      "height": 20,
      "text": "confirm?",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "a_confirm",
      "originalText": "confirm?",
      "autoResize": true
    },
    {
      "type": "arrow",
      "id": "a_merge",
      "x": 520,
      "y": 260,
      "width": 0,
      "height": 80,
      "points": [[0, 0], [0, -80]],
      "endArrowhead": "arrow",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "boundElements": [{ "id": "t_a_merge", "type": "text" }],
      "startBinding": { "elementId": "decision", "fixedPoint": [0.5, 0] },
      "endBinding": { "elementId": "main", "fixedPoint": [0.5, 1] }
    },
    {
      "type": "text",
      "id": "t_a_merge",
      "x": 530,
      "y": 235,
      "width": 100,
      "height": 20,
      "text": "yes: merge",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "a_merge",
      "originalText": "yes: merge",
      "autoResize": true
    },
    {
      "type": "arrow",
      "id": "a_rebase",
      "x": 610,
      "y": 320,
      "width": 80,
      "height": 0,
      "points": [[0, 0], [80, 0]],
      "endArrowhead": "arrow",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "boundElements": [{ "id": "t_a_rebase", "type": "text" }],
      "startBinding": { "elementId": "decision", "fixedPoint": [1, 0.5] },
      "endBinding": null
    },
    {
      "type": "text",
      "id": "t_a_rebase",
      "x": 625,
      "y": 300,
      "width": 80,
      "height": 20,
      "text": "yes: rebase",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "a_rebase",
      "originalText": "yes: rebase",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "t_rebase_target",
      "x": 700,
      "y": 310,
      "width": 160,
      "height": 20,
      "text": "onto main, then merge",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "middle",
      "originalText": "onto main, then merge",
      "autoResize": true
    },
    {
      "type": "arrow",
      "id": "a_stray_down",
      "x": 230,
      "y": 370,
      "width": 0,
      "height": 110,
      "points": [[0, 0], [0, 110]],
      "endArrowhead": "arrow",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "startBinding": { "elementId": "feature", "fixedPoint": [0.5, 1] },
      "endBinding": { "elementId": "stray", "fixedPoint": [0.5, 0] }
    },
    {
      "type": "text",
      "id": "t_stray_label",
      "x": 240,
      "y": 410,
      "width": 140,
      "height": 20,
      "text": "no confirmation / old",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#e03131",
      "textAlign": "left",
      "verticalAlign": "middle",
      "originalText": "no confirmation / old",
      "autoResize": true
    },
    {
      "type": "rectangle",
      "id": "scanner",
      "x": 400,
      "y": 480,
      "width": 240,
      "height": 90,
      "roundness": { "type": 3 },
      "backgroundColor": "#d0bfff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "boundElements": [
        { "id": "t_scanner", "type": "text" },
        { "id": "a_scanner_alert", "type": "arrow" }
      ]
    },
    {
      "type": "text",
      "id": "t_scanner",
      "x": 415,
      "y": 500,
      "width": 210,
      "height": 45,
      "text": "Hermes worktree scanner (cron)",
      "fontSize": 18,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "scanner",
      "originalText": "Hermes worktree scanner (cron)",
      "autoResize": true
    },
    {
      "type": "arrow",
      "id": "a_scanner_alert",
      "x": 340,
      "y": 525,
      "width": 60,
      "height": 0,
      "points": [[0, 0], [-60, 0]],
      "endArrowhead": "arrow",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "startBinding": { "elementId": "scanner", "fixedPoint": [0, 0.5] },
      "endBinding": { "elementId": "stray", "fixedPoint": [1, 0.5] }
    },
    {
      "type": "text",
      "id": "t_scanner_alert",
      "x": 355,
      "y": 505,
      "width": 60,
      "height": 20,
      "text": "detects",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "a_scanner_alert",
      "originalText": "detects",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "title",
      "x": 180,
      "y": 40,
      "width": 600,
      "height": 30,
      "text": "Git Hygiene State Machine: no stray branches / worktrees",
      "fontSize": 24,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "middle",
      "originalText": "Git Hygiene State Machine: no stray branches / worktrees",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "subtitle",
      "x": 180,
      "y": 75,
      "width": 650,
      "height": 20,
      "text": "Every feature branch/worktree must be confirmed and returned to main (merge or rebase+merge).",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#5c5c5c",
      "textAlign": "left",
      "verticalAlign": "middle",
      "originalText": "Every feature branch/worktree must be confirmed and returned to main (merge or rebase+merge).",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "scanner_checks",
      "x": 680,
      "y": 485,
      "width": 280,
      "height": 100,
      "text": "Scanner checks:\n• non-main branch exists\n• not merged into main\n• older than threshold\n• no recent conductor log\n• dirty main worktree",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "top",
      "originalText": "Scanner checks:\n• non-main branch exists\n• not merged into main\n• older than threshold\n• no recent conductor log\n• dirty main worktree",
      "autoResize": true
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff"
  }
}
